      "type": "object"
    },
    "GateResult": {
      "additionalProperties": false,
      "description": "The outcome of one verification gate.\n\n``summary`` is the one line that appears in the gate table, so it must say\nwhat happened rather than what was checked: \"L4,L2 share first author \u2014 1\ngroup\" is a result, \"checked independence\" is not.",
      "properties": {
        "halting": {
          "default": false,
          "description": "Whether a failure here stops the process. Set from params, not by the gate.",
          "title": "Halting",
          "type": "boolean"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/ValidationIssue"
          },
          "title": "Issues",
          "type": "array"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "warn",
            "fail",
            "skip"
          ],
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "default": "",
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "name",
        "status"
      ],
      "title": "GateResult",
      "type": "object"
    },
