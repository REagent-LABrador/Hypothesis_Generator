          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Path",
          "type": "array"
        },
        "provenance": {
          "default": "",
          "title": "Provenance",
          "type": "string"
        },
        "rank_score": {
          "default": 0.0,
          "title": "Rank Score",
          "type": "number"
        },
        "scores": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Scores",
          "type": "object"
        },
        "subject": {
          "title": "Subject",
          "type": "string"
        },
        "subject_name": {
          "title": "Subject Name",
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "verdict": {
          "anyOf": [
            {
              "enum": [
