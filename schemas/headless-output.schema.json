  "$id": "https://labrador.dev/schemas/headless-output.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "OUTPUT of hypgen-run. COMPLETE carries the focused hypothesis, cards, and ROI request; CANNOT_COMPLETE carries a stable terminal error.",
  "properties": {
    "cards": {
      "anyOf": [
        {
          "$ref": "#/$defs/WebPayload"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/HeadlessError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "execution_mode": {
      "enum": [
        "LIVE",
        "REPLAY"
      ],
      "title": "Execution Mode",
      "type": "string"
    },
    "hypothesis": {
      "anyOf": [
        {
          "$ref": "#/$defs/HypothesisDocument"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "output_origin": {
      "enum": [
        "LIVE_PROVIDER",
        "DETERMINISTIC_REPLAY"
      ],
      "title": "Output Origin",
      "type": "string"
    },
    "roi_request": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Roi Request"
    },
    "status": {
      "enum": [
        "COMPLETE",
        "CANNOT_COMPLETE"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "status",
    "execution_mode",
    "output_origin"
  ],
  "title": "HeadlessResponse",
  "type": "object"
}
