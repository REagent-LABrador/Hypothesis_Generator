    "HypothesisDocument": {
      "additionalProperties": true,
      "description": "THE OUTPUT. One run over one knowledge graph produces exactly one of these.\n\nWritten as ``hypothesis.json``. This is a single hypothesis -- the one that\nranked first -- not a slate. A run still enumerates, scores and ranks many\ncandidates internally, because that is how it knows which one is best, but\nonly the winner crosses this boundary.\n\nThe document is self-contained on purpose: ``provenance`` says what it was\nrun on and with what stance, ``hypothesis`` is the claim with its evidence\nand its verification, and ``asks`` names the requests that would move it.\nNothing here needs the graph to be re-read to be understood.\n\nReading order for a consumer: ``schema_version``, then\n``provenance.coverage``, then ``hypothesis.verification.verdict``, then the\nclaim itself. A hypothesis carrying an error-level issue is not a finding.",
      "properties": {
        "asks": {
          "description": "Requests back to the graph builder that would move this hypothesis.",
          "items": {
            "$ref": "#/$defs/Ask"
          },
          "title": "Asks",
          "type": "array"
        },
        "hypothesis": {
          "$ref": "#/$defs/Hypothesis",
          "description": "The hypothesis itself: one claim, with its evidence."
        },
        "provenance": {
          "$ref": "#/$defs/Provenance",
          "description": "What produced this hypothesis."
        },
        "schema_version": {
          "default": "2.0",
          "description": "Version of the hypothesis.json contract this file was written against.",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "provenance",
        "hypothesis"
      ],
      "title": "HypothesisDocument",
      "type": "object"
    },
    "Interpretability": {
      "additionalProperties": false,
