{
  "$defs": {
    "Articulation": {
      "additionalProperties": false,
      "description": "What the model is asked to produce from one structural candidate.",
      "properties": {
        "assumptions": {
          "description": "What must be true but is not in the graph.",
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "claims": {
          "description": "The hypothesis decomposed into checkable pieces.",
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Claims",
          "type": "array"
        },
        "decisive_experiment": {
          "description": "The cheapest experiment that discriminates.",
          "title": "Decisive Experiment",
          "type": "string"
        },
        "falsifier": {
          "description": "The single observation that would kill this.",
          "title": "Falsifier",
          "type": "string"
        },
        "mechanism": {
          "description": "The proposed causal chain, in graph terms.",
          "title": "Mechanism",
          "type": "string"
        },
        "novel_because": {
          "description": "What the graph does NOT already state.",
          "title": "Novel Because",
          "type": "string"
        },
        "predictions": {
          "description": "Observations that should hold if this is true.",
          "items": {
            "type": "string"
          },
          "title": "Predictions",
          "type": "array"
        },
        "statement": {
          "description": "The hypothesis in one testable sentence.",
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "statement",
        "mechanism",
        "claims",
        "novel_because",
        "falsifier",
        "decisive_experiment"
      ],
      "title": "Articulation",
      "type": "object"
    },
    "Ask": {
      "additionalProperties": false,
      "description": "A request back to the graph builder. This is the loop closing.",
      "properties": {
        "ask": {
          "enum": [
            "expand_node",
            "resolve_link",
            "test_gap",
            "new_question"
          ],
          "title": "Ask",
          "type": "string"
        },
        "depth": {
          "default": "standard",
          "enum": [
            "quick",
            "standard",
            "deep",
            "exhaustive"
          ],
          "title": "Depth",
          "type": "string"
        },
        "for_hypothesis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "For Hypothesis"
        },
        "graph_id": {
          "title": "Graph Id",
          "type": "string"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "graph_id",
        "ask",
        "target"
      ],
      "title": "Ask",
      "type": "object"
    },
    "Assumption": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "title": "Basis",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "synthetic": {
          "title": "Synthetic",
          "type": "boolean"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit"
        },
        "value": {
          "title": "Value"
        }
      },
      "required": [
        "id",
        "path",
        "value",
        "unit",
        "basis",
        "synthetic"
      ],
      "title": "Assumption",
      "type": "object"
    },
    "Card": {
      "additionalProperties": false,
      "properties": {
        "headline": {
          "title": "Headline",
          "type": "string"
        },
        "highlights": {
          "items": {
            "$ref": "#/$defs/Highlight"
          },
          "title": "Highlights",
          "type": "array"
        },
        "hops": {
          "title": "Hops",
          "type": "integer"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "metrics": {
          "$ref": "#/$defs/Metrics"
        },
        "motif": {
          "title": "Motif",
          "type": "string"
        },
        "statement": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The articulated hypothesis, never clipped: it IS the claim.",
          "title": "Statement"
        },
        "status": {
          "$ref": "#/$defs/Status"
        },
        "trace": {
          "title": "Trace",
          "type": "string"
        }
      },
      "required": [
        "id",
        "headline",
        "trace",
        "motif",
        "hops",
        "metrics",
        "status",
        "highlights"
      ],
      "title": "Card",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "description": "One atomic, separately checkable assertion inside a hypothesis.",
      "properties": {
        "cites": {
          "description": "Ids from the evidence pack only (link, finding, paper, thing, or gap ids).",
          "items": {
            "type": "string"
          },
          "title": "Cites",
          "type": "array"
        },
        "inferred": {
          "default": false,
          "description": "True when the graph does not state this and it is a step of reasoning.",
          "title": "Inferred",
          "type": "boolean"
        },
        "text": {
          "description": "A single assertion, stated so it can be true or false on its own.",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "Claim",
      "type": "object"
    },
    "Counterfactual": {
      "additionalProperties": false,
      "properties": {
        "change": {
          "title": "Change",
          "type": "string"
        },
        "meaning": {
          "title": "Meaning",
          "type": "string"
        },
        "result": {
          "title": "Result",
          "type": "string"
        }
      },
      "required": [
        "change",
        "result",
        "meaning"
      ],
      "title": "Counterfactual",
      "type": "object"
    },
    "Critique": {
      "additionalProperties": false,
      "description": "The adversarial pass. Its job is to break the hypothesis, not polish it.",
      "properties": {
        "alternative_explanation": {
          "default": "",
          "description": "A duller reading of the same evidence, if one exists.",
          "title": "Alternative Explanation",
          "type": "string"
        },
        "lens": {
          "default": "",
          "description": "Which angle this critic was told to attack from. Set by the harness, not the model.",
          "title": "Lens",
          "type": "string"
        },
        "per_claim": {
          "items": {
            "$ref": "#/$defs/CritiqueFinding"
          },
          "title": "Per Claim",
          "type": "array"
        },
        "strongest_objection": {
          "title": "Strongest Objection",
          "type": "string"
        },
        "unsupported_leaps": {
          "items": {
            "type": "string"
          },
          "title": "Unsupported Leaps",
          "type": "array"
        },
        "verdict": {
          "enum": [
            "supported",
            "partly_supported",
            "unsupported",
            "contradicted"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "verdict",
        "strongest_objection"
      ],
      "title": "Critique",
      "type": "object"
    },
    "CritiqueFinding": {
      "additionalProperties": false,
      "properties": {
        "cites": {
          "items": {
            "type": "string"
          },
          "title": "Cites",
          "type": "array"
        },
        "claim_index": {
          "title": "Claim Index",
          "type": "integer"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "verdict": {
          "enum": [
            "supported",
            "partly_supported",
            "unsupported",
            "contradicted"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "claim_index",
        "verdict",
        "reason"
      ],
      "title": "CritiqueFinding",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "claim": {
          "title": "Claim",
