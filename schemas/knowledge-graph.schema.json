        },
        "confidence": {
          "$ref": "#/$defs/LinkConfidence"
        },
        "from": {
          "title": "From",
          "type": "string"
        },
        "how": {
          "title": "How",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "no": {
          "items": {
            "type": "string"
          },
          "title": "No",
          "type": "array"
        },
        "no_effect": {
          "items": {
            "type": "string"
          },
          "title": "No Effect",
          "type": "array"
        },
        "state": {
          "default": "single_source",
          "title": "State",
          "type": "string"
        },
        "to": {
          "title": "To",
          "type": "string"
        },
        "why": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Why"
        },
        "yes": {
          "items": {
            "type": "string"
          },
          "title": "Yes",
          "type": "array"
        }
      },
      "required": [
        "id",
        "from",
        "how",
        "to"
      ],
      "title": "Link",
      "type": "object"
    },
    "LinkConfidence": {
      "additionalProperties": true,
      "properties": {
        "agreement": {
          "default": 0.0,
          "title": "Agreement",
          "type": "number"
        },
        "evidence_quality": {
          "default": 0.0,
          "title": "Evidence Quality",
          "type": "number"
        },
        "independence": {
          "default": 0.0,
          "title": "Independence",
          "type": "number"
        },
        "label": {
          "default": "low",
          "title": "Label",
          "type": "string"
        },
        "overall": {
          "default": 0.0,
          "title": "Overall",
          "type": "number"
        }
      },
      "title": "LinkConfidence",
      "type": "object"
