{
  "$defs": {
    "Coverage": {
      "additionalProperties": true,
      "properties": {
        "depth": {
          "default": "standard",
          "title": "Depth",
          "type": "string"
        },
        "found": {
          "default": 0,
          "title": "Found",
          "type": "integer"
        },
        "limits": {
          "$ref": "#/$defs/Limits"
        },
        "no_quote_discarded": {
          "default": 0,
          "title": "No Quote Discarded",
          "type": "integer"
        },
        "read": {
          "default": 0,
          "title": "Read",
          "type": "integer"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        },
        "used": {
          "default": 0,
          "title": "Used",
          "type": "integer"
        }
      },
      "title": "Coverage",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": true,
      "properties": {
        "confidence": {
          "default": 0.5,
          "title": "Confidence",
          "type": "number"
        },
        "flags": {
          "items": {
            "type": "string"
          },
          "title": "Flags",
          "type": "array"
        },
        "from": {
          "title": "From",
          "type": "string"
        },
        "hedged": {
          "default": false,
          "title": "Hedged",
          "type": "boolean"
        },
        "how": {
          "title": "How",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "is_own_result": {
          "default": true,
          "title": "Is Own Result",
          "type": "boolean"
        },
        "paper": {
          "title": "Paper",
          "type": "string"
        },
        "quote": {
          "default": "",
          "title": "Quote",
          "type": "string"
        },
        "round": {
          "default": 1,
          "title": "Round",
          "type": "integer"
        },
        "says": {
          "default": "yes",
          "title": "Says",
          "type": "string"
        },
        "to": {
          "title": "To",
          "type": "string"
        },
        "where": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Where"
        }
      },
      "required": [
        "id",
        "from",
        "how",
        "to",
        "paper"
      ],
      "title": "Finding",
      "type": "object"
    },
    "Gap": {
      "additionalProperties": true,
      "properties": {
        "confidence": {
          "default": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "implied_by": {
          "items": {
            "type": "string"
          },
          "title": "Implied By",
          "type": "array"
        },
        "missing": {
          "items": {
            "type": "string"
          },
          "title": "Missing",
          "type": "array"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        },
        "searched_in_round": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Searched In Round"
        }
      },
      "required": [
        "id",
        "missing"
      ],
      "title": "Gap",
      "type": "object"
    },
    "Limits": {
      "additionalProperties": true,
