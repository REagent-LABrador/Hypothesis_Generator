        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "is_preprint": {
          "default": false,
          "title": "Is Preprint",
          "type": "boolean"
        },
        "journal": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Journal"
        },
        "round": {
          "default": 1,
          "title": "Round",
          "type": "integer"
