    "Round": {
      "additionalProperties": true,
      "properties": {
        "ask": {
          "title": "Ask",
          "type": "string"
        },
        "depth": {
          "default": "standard",
          "title": "Depth",
          "type": "string"
        },
        "n": {
          "title": "N",
          "type": "integer"
        },
        "papers_added": {
          "default": 0,
          "title": "Papers Added",
          "type": "integer"
        },
        "target": {
          "anyOf": [
            {
              "type": "string"
