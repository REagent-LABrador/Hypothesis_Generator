  "$id": "https://labrador.dev/schemas/knowledge-graph.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "INPUT to hyp_gen. A literature knowledge graph. Prose contract: src/hyp_gen/INPUT_SCHEMA.md",
  "properties": {
    "coverage": {
      "$ref": "#/$defs/Coverage"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "gaps": {
      "items": {
        "$ref": "#/$defs/Gap"
      },
      "title": "Gaps",
      "type": "array"
    },
    "generated_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Generated At"
    },
    "graph_id": {
      "title": "Graph Id",
      "type": "string"
    },
    "links": {
      "items": {
        "$ref": "#/$defs/Link"
      },
      "title": "Links",
      "type": "array"
    },
    "papers": {
      "items": {
        "$ref": "#/$defs/Paper"
      },
      "title": "Papers",
      "type": "array"
    },
    "question": {
      "default": "",
      "title": "Question",
      "type": "string"
    },
    "round": {
      "default": 1,
      "title": "Round",
      "type": "integer"
    },
    "rounds": {
      "items": {
        "$ref": "#/$defs/Round"
      },
      "title": "Rounds",
      "type": "array"
    },
    "schema_version": {
      "default": "1.1",
      "title": "Schema Version",
      "type": "string"
    },
    "things": {
      "items": {
        "$ref": "#/$defs/Thing"
      },
      "title": "Things",
      "type": "array"
    }
  },
  "required": [
    "graph_id"
  ],
  "title": "KnowledgeGraph",
  "type": "object"
}
