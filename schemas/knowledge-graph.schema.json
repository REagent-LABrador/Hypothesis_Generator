          "default": null,
          "title": "Max Papers"
        },
        "max_queries": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Queries"
        }
      },
      "title": "Limits",
      "type": "object"
    },
    "Link": {
      "additionalProperties": true,
      "properties": {
        "basis": {
          "default": "primary",
          "title": "Basis",
          "type": "string"
        },
